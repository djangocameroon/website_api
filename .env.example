ENVIRONMENT='development'
DEBUG=True
SECRET_KEY=''
ALLOWED_HOSTS='*'
CORS_ALLOWED_ORIGINS='http://127.0.0.1:3000'

# Database (external — managed separately)
DB_HOST='localhost'
DB_NAME='django_cameroon'
DB_USER=''
DB_PASSWORD=''
DB_PORT='5432'

# Web Server
WEB_PORT=8001

# Email
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Redis (external — managed separately)
REDIS_URL='redis://127.0.0.1:6379'

# Celery
CELERY_BROKER_URL='redis://127.0.0.1:6379/0'
CELERY_RESULT_BACKEND='redis://127.0.0.1:6379/0'
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# Gunicorn (web container)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_LOG_LEVEL=info

# Superuser (set CREATE_SUPERUSER=true to enable)
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_EMAIL='admin@djangocameroon.com'
DJANGO_SUPERUSER_USERNAME='admin'
DJANGO_SUPERUSER_PASSWORD=''

# Storage: set USE_S3_STORAGE=true for S3/MinIO
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_STORAGE_BUCKET_NAME=''
AWS_S3_REGION_NAME=''
AWS_S3_ENDPOINT_URL=''
AWS_S3_CUSTOM_DOMAIN=''

# Service readiness (wait-for-services.sh)
WAIT_RETRIES=30
WAIT_INTERVAL=2

# Twilio (for SMS notifications)
TWILIO_SID=''
TWILIO_AUTH_TOKEN=''
TWILIO_VERIFY_SERVICE_SID=''
TWILIO_PHONE_NUMBER=''

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
